{
  "name": "structured-context-map-views-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/navigator dev",
    "build": "bun run --cwd packages/map-views build && bun run --cwd apps/navigator build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "bun test",
    "test:package": "bun run --cwd packages/map-views test:package",
    "generate": "bun run --cwd packages/map-views generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "^1.4.3",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  }
}
