// Wardley map data as a generic XY plot: evolution across, visibility up, dependencies as lines.
// Deliberately not a Wardley renderer: no stage bands, pipelines, evolve arrows or annotations.
{
  $schema: 'https://raw.githubusercontent.com/mindsocket/structured-context-map-views/main/schemas/generated/latest/definition.json',
  title: 'Wardley XY',
  schema: 'sctx://wardley-mapping/wardley_map',
  parameters: {
    types: {
      title: 'Types',
      type: 'array',
      items: { enum: ['anchor', 'component', 'note', 'accelerator'] },
      uniqueItems: true,
      default: ['anchor', 'component'],
    },
    edgeFields: {
      title: 'Edges',
      type: 'array',
      items: { enum: ['dependsOn', 'flowsTo', 'pipelineOf'] },
      uniqueItems: true,
      default: ['dependsOn'],
    },
    nodeStyle: { $ref: 'settings.json#/$defs/nodeStyle', default: 'shape' },
  },
  regions: [
    {
      id: 'main',
      layout: {
        type: 'xy',
        x: { field: 'evolution', domain: [0, 1], label: 'Evolution' },
        y: { field: 'visibility', domain: [0, 1], label: 'Visibility' },
        types: { $param: 'types' },
        edgeFields: { $param: 'edgeFields' },
      },
      nodes: { style: { $param: 'nodeStyle' } },
    },
  ],
}
