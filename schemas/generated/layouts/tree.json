{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sctx-map-view://layouts/tree.json",
  "title": "Tree layout",
  "description": "A tree over the schema's hierarchy: root-type nodes at the top, children via hierarchy edges.",
  "type": "object",
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "tree"
    },
    "orientation": {
      "description": "Direction the tree grows.",
      "default": "vertical",
      "anyOf": [
        {
          "$ref": "sctx-map-view://settings.json#/$defs/orientation"
        },
        {
          "$ref": "sctx-map-view://definition.json#/$defs/paramRef"
        }
      ]
    },
    "dag": {
      "description": "How a node with several parents is shown.",
      "default": "repeat",
      "anyOf": [
        {
          "$ref": "sctx-map-view://layouts/tree.json#/$defs/dag"
        },
        {
          "$ref": "sctx-map-view://definition.json#/$defs/paramRef"
        }
      ]
    }
  },
  "$defs": {
    "dag": {
      "title": "Nodes with several parents",
      "description": "repeat: the node appears under each parent, its subtree shown once. cross-edge: the node appears under its first parent, with extra connectors from the others.",
      "enum": [
        "repeat",
        "cross-edge"
      ]
    }
  }
}
