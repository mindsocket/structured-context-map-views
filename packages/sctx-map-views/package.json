{
  "name": "sctx-map-views",
  "version": "0.7.2",
  "description": "structured-context render plugin: a space's map views as one self-contained interactive HTML file.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindsocket/structured-context-map-views.git",
    "directory": "packages/sctx-map-views"
  },
  "keywords": [
    "structured-context",
    "sctx",
    "plugin",
    "map-view"
  ],
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run --cwd ../map-views build:library && bun run bundle",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:package": "bash scripts/test-package.sh",
    "bundle": "bun run clean && bun scripts/build.ts && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "structured-context": "^0.26.0",
    "structured-context-map-views": "workspace:*"
  }
}
