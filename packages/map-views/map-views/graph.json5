// Every node and edge as a network. Any schema.
{
  $schema: 'https://raw.githubusercontent.com/mindsocket/structured-context-map-views/main/schemas/generated/latest/definition.json',
  $id: 'sctx-map-view://core/graph',
  title: 'Graph',
  parameters: {
    nodeStyle: { $ref: 'settings.json#/$defs/nodeStyle', default: 'shape' },
    labels: { type: 'boolean', title: 'Relationship labels', default: false },
    validation: { $ref: 'settings.json#/$defs/validationLevel', default: 'off' },
  },
  regions: [
    {
      id: 'main',
      layout: { type: 'graph' },
      nodes: { style: { $param: 'nodeStyle' }, validation: { $param: 'validation' } },
      edges: { show: true, labels: { $param: 'labels' } },
    },
  ],
}
