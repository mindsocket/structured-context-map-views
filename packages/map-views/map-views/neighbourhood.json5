// One node with the nodes it is related to around it. Any schema.
{
  $schema: 'https://raw.githubusercontent.com/mindsocket/structured-context-map-views/main/schemas/generated/latest/definition.json',
  $id: 'sctx-map-view://core/neighbourhood',
  title: 'Neighbourhood',
  parameters: {
    labels: { type: 'boolean', title: 'Relationship labels', default: true },
    validation: { $ref: 'settings.json#/$defs/validationLevel', default: 'off' },
  },
  regions: [
    {
      id: 'main',
      layout: { type: 'neighbourhood' },
      nodes: { validation: { $param: 'validation' } },
      edges: { show: true, labels: { $param: 'labels' } },
    },
  ],
}
